                "dangerous vaccine",
                "vaccine injury",
                "harmed? by vaccine",
                "vaccine death",
                "toxic vaccine",
                "poison"
            ],
            "keywords": ["autism", "death", "injury", "harm", "toxic", "poison", "kill"],
            "example_claims": [
                "Vaccines cause autism in children",
                "The vaccine killed my friend",
                "These toxic vaccines are injuring people"
            ],
            "severity_weight": 1.0
        },
